{
  "manifest_version": 3,
  "name": "Quiet Substack",
  "version": "1.2.0",
  "description": "Masque le fil d'accueil de Substack (interrupteur en haut à gauche), ajoute des raccourcis dans la barre latérale, élargit l'éditeur de note avec Post gallery et ton planning de créneaux, et un calendrier sur 15 jours pour déplacer, modifier, reprogrammer ou supprimer tes notes.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.substack.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Quiet Substack",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://substack.com/*"
      ],
      "js": [
        "feed.js"
      ],
      "css": [
        "feed.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://substack.com/*"
      ],
      "js": [
        "notes.js",
        "calendar.js"
      ],
      "css": [
        "notes.css",
        "calendar.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
