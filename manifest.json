{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.3.0",
  "description": "__MSG_extDescription__",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.substack.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://substack.com/*"
      ],
      "js": [
        "i18n.js",
        "feed.js"
      ],
      "css": [
        "feed.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://substack.com/*"
      ],
      "js": [
        "notes.js",
        "calendar.js"
      ],
      "css": [
        "notes.css",
        "calendar.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "default_locale": "en"
}
